{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-de-labs-avd"
		},
		"CleanDataConn_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'CleanDataConn'"
		},
		"ImmutableCopyConn_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ImmutableCopyConn'"
		},
		"RawData_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'RawData'"
		},
		"CleanDataConn_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://cleandataavdoyizode.dfs.core.windows.net/"
		},
		"ImmutableCopyConn_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://immutablecopyavdoyizode.dfs.core.windows.net/"
		},
		"RawData_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rawdataavdoyizode.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-de-labs-avd_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"CleanDataConn_accountKey": {
						"value": "[parameters('CleanDataConn_accountKey')]"
					},
					"ImmutableCopyConn_accountKey": {
						"value": "[parameters('ImmutableCopyConn_accountKey')]"
					},
					"RawData_accountKey": {
						"value": "[parameters('RawData_accountKey')]"
					},
					"CleanDataConn_properties_typeProperties_url": {
						"value": "[parameters('CleanDataConn_properties_typeProperties_url')]"
					},
					"ImmutableCopyConn_properties_typeProperties_url": {
						"value": "[parameters('ImmutableCopyConn_properties_typeProperties_url')]"
					},
					"RawData_properties_typeProperties_url": {
						"value": "[parameters('RawData_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}